{
  "app": {
    "bundleName": "com.songjy.synologydsmhelper",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "versionCode": 22,
    "versionName": "1.0.3.2",
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 5
    },
    "configuration": "$profile:configuration",
    "appPreloadPhase": "windowStageCreated"
  }
}